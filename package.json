{
  "name": "tuition-escrow",
  "version": "0.1.0-alpha",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "bindings": "turbo run bindings",
    "db:migrate": "pnpm --filter @tuition-escrow/api db:migrate",
    "db:seed": "pnpm --filter @tuition-escrow/api db:seed",
    "contract:build": "cargo build --target wasm32-unknown-unknown --release -p voucher",
    "contract:test": "cargo test",
    "contract:bindings": "./scripts/generate-bindings.sh",
    "deploy:testnet": "./scripts/deploy-testnet.sh",
    "identities:create": "./scripts/create-identities.sh",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@turbo/gen": "^1.12.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write",
    "*.rs": "cargo fmt --"
  }
}
