{
  "name": "@tuition-escrow/api",
  "version": "0.1.0-alpha",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "db:migrate": "node -r ts-node/register src/migrations/migrate.ts",
    "db:seed": "node -r ts-node/register src/migrations/seed.ts"
  },
  "dependencies": {
    "@tuition-escrow/shared": "workspace:*",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-openapi-validator": "^5.2.0",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "bullmq": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.0",
    "yaml": "^2.4.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.11.19",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1"
  }
}
