# ─── Stellar network ──────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIEND_BOT_URL=https://friendbot.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─── Deployed contracts ───────────────────────────────────────────────────
VOUCHER_CONTRACT_ID=
ASSET_CONTRACT_ID=
# deployLedger is stored in deployments/testnet.json — not an env var

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuition_escrow
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
API_BASE_URL=http://localhost:3001

# ─── KMS (local dev only — NOT for production) ────────────────────────────
KMS_PROVIDER=local
KMS_KEY_ID=dev-key
# Must be ≥ 32 UTF-8 bytes
KMS_WRAPPING_KEY=dev-wrapping-key-32-bytes-minimum-pad

# ─── Fee sponsorship ──────────────────────────────────────────────────────
# FEE_BUMP_SECRET_REF is a *reference* to the key in your secret store,
# NOT the key itself. Never put the actual secret here.
FEE_BUMP_SECRET_REF=
SPONSOR_ACCOUNT_ADDRESS=
# Minimum XLM balance (in stroops) before alerting
SPONSOR_BALANCE_THRESHOLD=100000

# ─── Web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ATTESTER_URL=http://localhost:3002
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_ASSET_CONTRACT_ID=

# ─── Attester ─────────────────────────────────────────────────────────────
ATTESTER_PORT=3002
ATTESTER_METRICS_PORT=9102
# 'local' | 'aws' | 'gcp' — use 'local' for testnet only
ATTESTER_KMS_PROVIDER=local
# For local dev only:
ATTESTER_SECRET=
ATTESTER_ADDRESS=
# For aws/gcp:
ATTESTER_KMS_KEY_ID=
# 'manual' | 'signed-export'
VERIFICATION_PROVIDER=manual
# Timeout (ms) for manual review polling
MANUAL_REVIEW_TIMEOUT_MS=30000
# Secret for SignedExportProvider (testing only)
SIGNED_EXPORT_SECRET=change-me

# ─── Indexer ──────────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL=5000
INDEXER_METRICS_PORT=9101

# ─── Background jobs ──────────────────────────────────────────────────────
# Days without TTL touch before we call extend_ttl
TTL_SAFETY_MARGIN_DAYS=30
# Comma-separated hours before expiry to send reminders
EXPIRY_REMINDER_HOURS=72,24,6

# ─── Monitoring ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Validation limits (mirrored from contract config) ───────────────────
MAX_VOUCHER_AMOUNT=1000000
MIN_VOUCHER_AMOUNT=10
MAX_EXPIRY_HOURS=8760
