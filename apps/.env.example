# ─── Stellar network ──────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIEND_BOT_URL=https://friendbot.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ─── Deployed contracts ───────────────────────────────────────────────────
VOUCHER_CONTRACT_ID=
ASSET_CONTRACT_ID=

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuition_escrow
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
API_BASE_URL=http://localhost:3001

# ─── KMS (local dev only — NOT for production) ────────────────────────────
KMS_PROVIDER=local
KMS_KEY_ID=dev-key
KMS_WRAPPING_KEY=dev-wrapping-key-32-bytes-minimum-pad

# ─── Fee sponsorship ──────────────────────────────────────────────────────
FEE_BUMP_SECRET_REF=
SPONSOR_ACCOUNT_ADDRESS=
SPONSOR_BALANCE_THRESHOLD=100000

# ─── Attester ─────────────────────────────────────────────────────────────
ATTESTER_PORT=3002
ATTESTER_METRICS_PORT=9102
ATTESTER_KMS_PROVIDER=local
ATTESTER_SECRET=
ATTESTER_ADDRESS=
ATTESTER_KMS_KEY_ID=
VERIFICATION_PROVIDER=manual
MANUAL_REVIEW_TIMEOUT_MS=30000
SIGNED_EXPORT_SECRET=change-me

# ─── Indexer ──────────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL=5000
INDEXER_METRICS_PORT=9101

# ─── Background jobs ──────────────────────────────────────────────────────
TTL_SAFETY_MARGIN_DAYS=30
EXPIRY_REMINDER_HOURS=72,24,6

# ─── Monitoring ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Validation limits ────────────────────────────────────────────────────
MAX_VOUCHER_AMOUNT=1000000
MIN_VOUCHER_AMOUNT=10
MAX_EXPIRY_HOURS=8760

# ─── Web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ATTESTER_URL=http://localhost:3002
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_ASSET_CONTRACT_ID=
